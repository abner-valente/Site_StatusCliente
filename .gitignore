# ---------------------------------------------------------------------------
# Segredos — nunca versionar
# ---------------------------------------------------------------------------
# A service_role key do Supabase ignora RLS e GRANT: quem a tiver lê e escreve
# tudo, de qualquer lugar. Ela vive só no .env local e, na fase 3, nos secrets
# do GitHub Actions.
.env
.env.*
!.env.example
*.key
*.pem
credenciais*.json


# ---------------------------------------------------------------------------
# Dados de cliente — ver DECISAO_DADOS.md
# ---------------------------------------------------------------------------
# A planilha tem nome, imóvel, corretor e data de assinatura de 15 compradores
# reais. Uma vez commitado e enviado, o arquivo fica no histórico do Git para
# sempre — apagar depois não o remove. Fora por padrão.
*.xlsx
*.xls
~$*
dados/



# ---------------------------------------------------------------------------
# Supabase CLI
# ---------------------------------------------------------------------------
supabase/.temp/
supabase/.branches/


# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ---------------------------------------------------------------------------
# Sistema e editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp


# ---------------------------------------------------------------------------
# Saída local
# ---------------------------------------------------------------------------
*.log
saida/
tmp/

# Qualquer coisa gerada para colar na planilha. Padrão, e não nome por nome,
# porque esses arquivos carregam dado de cliente real e a lista por nome já
# ficou atrás uma vez: `emails_para_colar.txt` nasceu numa recuperação de
# emergência e o Git o viu como novo arquivo, pronto para ser commitado.
#
# Histórico do Git é permanente — dado commitado não sai apagando depois.
*_para_colar.*
uids_para_colar.txt
titulares_para_colar.csv
